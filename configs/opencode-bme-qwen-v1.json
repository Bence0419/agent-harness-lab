{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "bme-lab": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BME Lab",
      "options": {
        "baseURL": "https://llm.example.org/v1",
        "apiKey": "{env:BME_LAB_API_KEY}"
      },
      "models": {
        "Qwen/Qwen3.6-35B-A3B-FP8": {
          "name": "BME Qwen 35B A3B FP8",
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      }
    }
  },
  "permissions": [
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
